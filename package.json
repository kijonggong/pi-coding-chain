{
  "name": "pi-coding-chain",
  "version": "1.0.0",
  "description": "Pi extensions for a coding model chain: compose the LiteLLM router config, or run the same fail-over inside Pi without a proxy",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/coding-fallback",
      "extensions/aaii-router",
      "extensions/quota-providers",
      "extensions/openrouter-catalog-filter"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
